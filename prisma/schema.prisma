// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // TOTP second factor. The secret is encrypted with ENCRYPTION_KEY; backup
  // codes are stored as SHA-256 hashes and consumed on use.
  totpSecret      String?
  totpEnabledAt   DateTime?
  totpBackupCodes String[]  @default([])

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  socialAccounts    SocialAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

enum Platform {
  INSTAGRAM
  FACEBOOK
}

model SocialAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  platform          Platform @default(INSTAGRAM)
  // The Instagram business account id, or the Facebook Page id.
  externalId        String   @unique
  // Instagram only — null for Facebook Pages.
  username          String?
  name              String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations Automation[]
  dmLogs      DmLog[]
  linkClicks  LinkClick[]

  @@index([workspaceId])
  @@index([platform])
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  socialAccountId    String

  name           String
  goal           String?
  postId         String?
  postUrl        String?
  pendingNextReel Boolean @default(false)
  matchAnyPost   Boolean @default(false)
  // Story-reply campaigns fire on keyword DMs sent in reply to any story,
  // instead of on comments. They carry no target post.
  matchStoryReplies Boolean @default(false)
  keywords       String[]
  matchAnyWord   Boolean @default(false)
  dmMessage      String
  dmMessages     String[] @default([])
  openingDmEnabled     Boolean @default(false)
  openingDmMessage     String?
  openingDmButtonLabel String?
  linkButtonLabel      String?
  publicReplyEnabled Boolean @default(false)
  publicReplyMessage String?
  publicReplyMessages String[] @default([])
  isActive       Boolean @default(true)
  wholeWordMatch Boolean @default(true)
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount    SocialAccount    @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]

  @@index([workspaceId])
  @@index([socialAccountId])
  @@index([postId])
}

model DmLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  socialAccountId    String

  commenterId   String
  commenterName String?
  commentText   String
  commentId     String
  matchedKeyword String?
  // The Instagram media (post/reel) the comment was left on. Null for
  // story-reply DMs and for button-tap reveal rows that could not be traced
  // back to an originating comment. Lets DMs be counted per post.
  mediaId       String?
  // For story-reply DMs: the story that was replied to. The reply text itself
  // is never stored — only the matched keyword identifies the trigger.
  storyId       String?
  status        DmStatus @default(PENDING)
  attempts      Int      @default(0)
  dmSentAt      DateTime?
  errorMessage  String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  publicReplySentAt DateTime?
  publicReplyError  String?

  // Set only when the opening DM (button, "awaiting confirmation") was sent —
  // dmSentAt/status=SENT above fire for BOTH the opening DM and the reveal, so
  // this is the only way to tell "waiting on a tap" from "already confirmed"
  // (Plume 14/09 : rappel aux gens qui n'ont pas cliqué). reminderSentAt marks
  // the one-shot reminder as sent (or attempted), never retried past that.
  openingDmSentAt DateTime?
  reminderSentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  socialAccount    SocialAccount    @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([openingDmSentAt])
  @@index([socialAccountId])
  @@index([status])
  @@index([automationId, mediaId])
}

// Every comment the system has seen, from either the webhook or the polling
// reconciler. This is the shared dedup set: a comment id present here has
// already been queued for processing, so neither path acts on it twice. It is
// distinct from DmLog (which only records comments that matched a campaign);
// this records all comments so the reconciler doesn't re-sweep non-matching
// ones every cycle.
model ProcessedComment {
  id              String   @id @default(cuid())
  socialAccountId String
  commentId       String   @unique
  source          String // "WEBHOOK" | "POLLING"
  seenAt          DateTime @default(now())

  @@index([socialAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  socialAccountId    String
  trackedLinkId      String
  // Per-post attribution token carried on the short link (`?src=ig<mediaId>`),
  // validated against ^[a-z0-9-]{1,24}$ before it is stored or forwarded.
  src                String?
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  socialAccount    SocialAccount    @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([socialAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
  @@index([src])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  workspaceId String?
  object      String?
  payload     Json
  status      WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}
